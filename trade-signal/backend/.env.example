# PostgreSQL connection string
DATABASE_URL=postgres://user:pass@localhost:5432/trade_signal

# HTTP server port
PORT=4100

# CORS origin (frontend)
CORS_ORIGIN=http://localhost:5173

# Telegram bot (ottenuto da @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scheduler cron (ogni 5 minuti default)
SCAN_INTERVAL_CRON=*/5 * * * *

# Binance REST endpoint
BINANCE_BASE_URL=https://api.binance.com

# Node env
NODE_ENV=development
